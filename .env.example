APP_ENV=local
DATABASE_URL=postgresql://user:pass@host/db
# Direct/unpooled URL for Alembic and pg_dump/pg_restore (Neon hostname without -pooler)
DIRECT_DATABASE_URL=postgresql://user:pass@host/db
# SECRET_KEY must be at least 32 characters in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=fallback-key-for-dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
DOCS_ENABLED=true
DOCS_IN_PRODUCTION=false
OBSERVABILITY_ENABLED=false
OBSERVABILITY_URL=http://localhost:8080
OBS_API_KEY=your-project-key-here
VERSION=1.0.0
DB_LOG_QUERIES=true
DB_SLOW_QUERY_MS=300

# Cache Configuration
CACHE_ENABLED=true
CACHE_LIVE_DATA_TTL=60
CACHE_TOURNAMENT_DATA_TTL=300
CACHE_STATIC_DATA_TTL=3600
CACHE_REFERENCE_DATA_TTL=21600
